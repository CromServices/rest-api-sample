# Copy to .env for local runs (never commit .env). All values are optional.
# Port the server listens on (Fly sets this from fly.toml [env]).
PORT=3000
# Interface to bind. 0.0.0.0 for containers, 127.0.0.1 for local-only.
HOST=0.0.0.0
# Set to "production" in the container image.
NODE_ENV=development
